<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="Npgsql" Version="11.0.0" />
    <PackageReference Include="WolverineFx" Version="6.65.1" />
    <PackageReference Include="WolverineFx.Postgresql" Version="6.65.1" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.65.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
